# FlowGen Studio Configuration
# Copy this file to .env and adjust variables as needed

# Secret API Key for AI Agents & Remote REST calls
FLOWGEN_API_KEY=fg_live_production_secret

# Server host & port binding
FLOWGEN_HOST=0.0.0.0
FLOWGEN_PORT=8787

# Number of parallel Chromium worker tabs (1 to 4)
FLOWGEN_WORKERS=2

# Default base directory to save generated batches
FLOWGEN_OUTPUT_DIR=output

# Whether to run Chrome headless (true for servers, false for local debugging)
FLOWGEN_HEADLESS=true
